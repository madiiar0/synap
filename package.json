{
  "name": "synapai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @synapai/server --filter @synapai/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "smoke": "pnpm --filter @synapai/server smoke",
    "seed": "pnpm --filter @synapai/server seed",
    "check-i18n": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0"
  }
}
