# Firebase browser configuration. These VITE_ values are public identifiers
# and must all come from the same Firebase project as the backend service key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only variable for the Vercel /api proxy. Do not prefix with VITE_.
# Use the separately deployed backend origin without a trailing slash.
BACKEND_URL=https://your-backend.vercel.app

# Build-time canonical origin for prerendered metadata, hreflang, the sitemap
# and llms.txt. Production builds ignore it and always publish the checked-in
# canonical origin (https://akrux.app); set it only for a self-hosted or
# non-production build that must advertise a different origin.
PUBLIC_SITE_URL=
