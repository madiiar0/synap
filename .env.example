# ------------------------------------------------------------------
# Synap environment. Copy to .env and fill in. Every value is optional
# in DEMO_MODE=true — the app runs fully offline on labeled fixtures.
#
# The only external credentials the product needs (§9):
#   PERPLEXITY_API_KEY, Firebase (auth), MongoDB, SMTP.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
APP_BASE_URL=http://localhost:4000
BRAND_NAME=Synap
# Generate with `openssl rand -hex 32`. Required (non-default) in production.
JWT_SECRET=change_me
MONGODB_URI=mongodb://localhost:27017/synapai
# Optional; empty => in-process (inline) job queue, no Redis needed.
REDIS_URL=

# --- AI provider (§1). ONE key: every engine (ChatGPT, Gemini, Perplexity,
# Claude, Grok) and the extraction/prompt-gen model are called through
# Perplexity's Agent API. Model ids and rates live in packages/shared/src/engines.ts.
PERPLEXITY_API_KEY=

# --- Scan shape (§2). Defaults from packages/shared/src/scanConfig.ts.
# Free scan: 25 prompts = 9 core × 3 core engines (27) + 16 tail split
# evenly across the tail engines = 43 calls.
FREE_SCAN_PROMPTS=25
FREE_CORE_PROMPTS=9
FREE_CORE_ENGINES=chatgpt,gemini,perplexity
FREE_TAIL_ENGINES=chatgpt,gemini

# --- Quotas & abuse controls (§6). The server is the authority.
FREE_SCANS_PER_ACCOUNT=3
DAILY_SCAN_CAP=200
SCAN_STARTS_PER_IP_PER_DAY=5
NEW_ACCOUNTS_PER_IP_PER_DAY=3
# Hard $ stop for the day; running scans pause and the admin is emailed.
DAILY_LLM_BUDGET_USD=10
PUBLIC_ANALYTICS_ENABLED=false
SITE_NOINDEX=false

# --- Conversion
# Empty => the Book-a-call button opens the fallback lead form modal.
CALENDLY_URL=
WHATSAPP_URL=

# --- Email. SMTP unset => rendered emails are written to
# apps/server/.mail-outbox/*.html instead (never crashes).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Synap <no-reply@synapai.app>"
# This account is auto-promoted to admin (unlimited scans) on boot (§7).
# Lead notifications and budget alerts also go here.
ADMIN_EMAIL=admin@synapai.app

# --- Auth (§5): Firebase only. Without credentials the server runs
# AUTH_MODE=mock (email-only dev sign-in; refused in production). Server side:
AUTH_MODE=
# base64 of the Firebase service-account JSON (or set GOOGLE_APPLICATION_CREDENTIALS to a file path)
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Client side (Vite; put these in apps/client/.env or the shell):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# --- Demo. Fixtures, zero API cost; keep true until keys exist.
DEMO_MODE=true
# How long a staged demo scan takes end-to-end (ms).
DEMO_SCAN_TOTAL_MS=18000
