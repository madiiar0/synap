# ------------------------------------------------------------------
# SynapAI environment. Copy to .env and fill in. Every value is optional
# in DEMO_MODE=true — the app runs fully offline on labeled fixtures.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
APP_BASE_URL=http://localhost:4000
BRAND_NAME=SynapAI
JWT_SECRET=803c03006f03e48deabb1d28dbd4d11725469ff5abf72ed9bacd5eb04b061de7
MONGODB_URI=mongodb://localhost:27017/synapai
# Optional; empty => in-process (inline) job queue, no Redis needed.
REDIS_URL=

# --- Engines. Perplexity is the core engine; others optional (missing key => engine off).
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
OPENAI_API_KEY=
# Verify current cheap tier; used via the Responses API with the web_search tool.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# Verify current id at https://docs.claude.com
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
# Google Search grounding is enabled for this model.
GEMINI_MODEL=gemini-2.5-flash
# platform.deepseek.com — OpenAI-compatible chat API.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# console.x.ai — Grok with Live Search (mode auto).
XAI_API_KEY=
GROK_MODEL=grok-3-mini
# Cheap model used for mention extraction + prompt generation; any engine id
# from: perplexity | chatgpt | gemini | claude
EXTRACTION_PROVIDER=perplexity

# --- Scan depth & engine sets (comma lists)
SCAN_PROMPTS_FREE=25
SCAN_PROMPTS_FULL=100
ENGINES_FREE=perplexity
ENGINES_FULL=perplexity,chatgpt,gemini,claude,deepseek,grok
# Hard stop for the day; running scans pause and the admin is emailed.
DAILY_LLM_BUDGET_USD=10

# --- Public scan rate limits
PUBLIC_SCAN_PER_IP_PER_DAY=3
PUBLIC_SCAN_GLOBAL_PER_DAY=30

# --- Conversion
# Empty => the Book-a-call button opens the fallback lead form modal.
CALENDLY_URL=
WHATSAPP_URL=

# --- Email. SMTP unset => rendered emails are written to
# apps/server/.mail-outbox/*.html instead (never crashes).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SynapAI <no-reply@synapai.app>"
# Where lead notifications and budget alerts go.
ADMIN_EMAIL=admin@synapai.app

# --- Auth (Firebase). Without credentials the server runs AUTH_MODE=mock
# (email-only dev sign-in; refused in production). Server side:
AUTH_MODE=
# base64 of the Firebase service-account JSON (or set GOOGLE_APPLICATION_CREDENTIALS to a file path)
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Client side (Vite; put these in apps/client/.env or the shell):
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# --- Demo. Fixtures, zero API cost; keep true until keys exist.
DEMO_MODE=true
# How long a staged demo scan takes end-to-end (ms).
DEMO_SCAN_TOTAL_MS=18000
